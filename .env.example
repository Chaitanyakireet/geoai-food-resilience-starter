# Backend environment variables. Copy this file to `.env` and fill in real
# values -- `.env` is gitignored and never committed. Every variable here is
# read server-side only; none is ever exposed in an API response.

# --- AI Copilot (backend/ai/provider.py) ------------------------------------
# Optional. With no ANTHROPIC_API_KEY set, the app runs entirely on its
# deterministic fallback (backend/ai/fallback.py) -- every tool, the Decision
# Brief, and the Copilot conversation all still work, just without LLM-
# generated prose.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5

# --- CORS (backend/api/main.py) ---------------------------------------------
# Optional, comma-separated. localhost:3000/127.0.0.1:3000 are always allowed
# for local development; add your deployed frontend origin(s) here in
# production (e.g. a Railway frontend URL).
CORS_ALLOWED_ORIGINS=

# --- NASA Earthdata Login (scripts/build_vegetation_features.py only) -------
# Only needed to re-run the one-off NDVI data-refresh script -- not read by
# the running API server. Free account at https://urs.earthdata.nasa.gov/.
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=
